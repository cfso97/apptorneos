PORT=3001

# Postgres (Railway/Supabase en el MVP). Usuario superusuario: solo para
# `prisma migrate` y `prisma/seed.ts` (necesitan crear tablas/roles). El
# backend en ejecución NUNCA usa esta variable — ver RUNTIME_DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/torneos_saas"

# El backend en ejecución (runtime) se conecta con el rol de Postgres
# `app_runtime` (sin privilegios de superusuario, creado en la migración de
# RLS de la Fase 1: fase1_rls_setup) para que las políticas de Row-Level
# Security de organizations/memberships/audit_log se apliquen de verdad — un
# superusuario siempre se las salta. `PrismaService` falla al arrancar si
# esta variable no está seteada, a propósito (falla segura).
# Contraseña de desarrollo en texto plano, mismo criterio que
# POSTGRES_PASSWORD en docker-compose.yml (solo para tu máquina) — ANTES DE
# PRODUCCIÓN hay que generar una contraseña real distinta para `app_runtime`
# en el Postgres administrado (Railway/Supabase), nunca reusar esta.
RUNTIME_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password_CHANGE_ME@localhost:5432/torneos_saas"

# Redis (cache, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="changeme"
# Duración del access token (JWT). Formato simple: "15m", "1h", "30d".
JWT_ACCESS_EXPIRES_IN="15m"
# Duración del refresh token (token opaco, no JWT — se guarda hasheado en `refresh_tokens`).
JWT_REFRESH_EXPIRES_IN="30d"
# Duración del token de "olvidé mi contraseña" (se guarda hasheado en `password_reset_tokens`).
PASSWORD_RESET_EXPIRES_IN="1h"

# URL del panel web (apps/web), para construir el link de "¿Olvidó su contraseña?"
# que en desarrollo se muestra en el log del servidor (todavía no hay envío de email real).
FRONTEND_URL="http://localhost:3000"
