PORT=3001

# Postgres (Railway/Supabase en el MVP)
DATABASE_URL="postgresql://user:password@localhost:5432/torneos_saas"

# Redis (cache, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="changeme"
# Duración del access token (JWT). Formato simple: "15m", "1h", "30d".
JWT_ACCESS_EXPIRES_IN="15m"
# Duración del refresh token (token opaco, no JWT — se guarda hasheado en `refresh_tokens`).
JWT_REFRESH_EXPIRES_IN="30d"
# Duración del token de "olvidé mi contraseña" (se guarda hasheado en `password_reset_tokens`).
PASSWORD_RESET_EXPIRES_IN="1h"

# URL del panel web (apps/web), para construir el link de "¿Olvidó su contraseña?"
# que en desarrollo se muestra en el log del servidor (todavía no hay envío de email real).
FRONTEND_URL="http://localhost:3000"
